# Образец параметров подписи release-APK.
# Скопируй в keystore.properties и подставь свои значения.
# Реальный keystore.properties и сам .jks в git НЕ коммитятся (см. .gitignore).
#
# Путь к keystore указывается относительно каталога client_android/.
storeFile=yogurt-release.jks
storePassword=ЗАМЕНИ_МЕНЯ
keyAlias=yogurt
keyPassword=ЗАМЕНИ_МЕНЯ
